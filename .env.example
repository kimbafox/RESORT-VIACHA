# Copia este archivo como ".env" y completa los valores. El archivo .env NO se sube a Git.

# Clave para firmar los tokens de sesión (mínimo 32 caracteres, aleatoria).
# Generar una:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto publicado en tu máquina (opcional)
HOST_PORT=3000
